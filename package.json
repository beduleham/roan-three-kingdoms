{
  "name": "roan-three-kingdoms",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim:smoke": "npm run build && node packages/battle-core/dist/smoke.js",
    "build": "tsc -p packages/battle-core/tsconfig.build.json",
    "format": "prettier --write packages package.json tsconfig.json vitest.config.ts",
    "format:check": "prettier --check packages package.json tsconfig.json vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
